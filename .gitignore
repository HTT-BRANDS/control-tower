*.bak

# Secrets (never commit these!)
*.pem
*.key
secrets.json
credentials.json

# Explicit secret protection (defense in depth)
.sp-secrets.env
**/sp-secrets*
*.secrets.env

# Node (if using any JS build tools)
node_modules/

# E2E test screenshots
tests/e2e/screenshots/

# Jupyter
.ipynb_checkpoints/

# OIDC configuration backups
infrastructure/.oidc-config-*.json

# Tenant configuration (contains real Azure AD IDs — LOW-1)
config/tenants.yaml
!config/tenants.yaml.example

# Persona → group mapping (contains real Entra ID group object IDs)
config/personas.yaml
!config/personas.yaml.example
APRIL-3rd-Log*

# Raw pricing query dumps - large JSON files from Azure Retail Prices API research.
# We commit the summary markdown files (analysis.md, recommendations.md, sources.md)
# but exclude raw-findings/ to keep the repo slim. See docs/COST_MODEL_AND_SCALING.md.
research/*/raw-findings/

# Tailwind v3 standalone binary (downloaded by scripts/bootstrap-css.sh)
/bin/tailwindcss
# Visual parity testing (py7u.4) — diff artifacts only, NOT baselines
tests/e2e/visual_diffs/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
